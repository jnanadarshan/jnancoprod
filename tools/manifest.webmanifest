{
  "id": "./",
  "name": "HomeAssistant Tools",
  "short_name": "HA Tools",
  "description": "ESPHome Display Designer, ESPHome LVGL Designer and the MMWAVE Creator in one installable app.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0d0f17",
  "theme_color": "#6366f1",
  "categories": ["developer", "design", "productivity"],
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "ESPHome Display Designer", "short_name": "Display", "url": "esphome-display/", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "ESPHome LVGL Designer", "short_name": "LVGL", "url": "esphome-lvgl/", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "MMWAVE Creator", "short_name": "MMWAVE", "url": "mmwave/", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "file_handlers": [
    { "action": "./esphome-lvgl/", "accept": { "text/yaml": [".yaml", ".yml"] } }
  ]
}
