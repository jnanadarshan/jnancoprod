{
  "name": "LVGL Studio for ESPHome",
  "short_name": "LVGL Studio",
  "description": "Design ESPHome LVGL touchscreen UIs visually with a realistic preview, then export the YAML.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0d0f17",
  "theme_color": "#6366f1",
  "categories": ["developer", "design", "productivity"],
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "text/yaml": [".yaml", ".yml"] } }
  ]
}
